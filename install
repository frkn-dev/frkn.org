#!/usr/bin/env bash
set -euo pipefail

FRKN_INSTALL_VERSION="1.2.6"
FNODE_VERSION="${FNODE_VERSION:-v0.6.41}"
API_ENDPOINT="${API_ENDPOINT:-https://api.frkn.org}"
ZMQ_ENDPOINT="${ZMQ_ENDPOINT:-tcp://api.frkn.org:3001}"
METRICS_ZMQ_ENDPOINT="${METRICS_ZMQ_ENDPOINT:-tcp://api.frkn.org:3002}"
ACME_EMAIL="${ACME_EMAIL:-acme@frkn.org}"
HTTP_AUTH_URL="${HTTP_AUTH_URL:-https://api.frkn.org/auth}"

PROFILE="full"
MODE=""
INSTALL_TOKEN=""
API_TOKEN=""
ENV_NAME="dev"
LABEL=""
COUNTRY=""
NODE_UUID=""
HOSTNAME_OVERRIDE=""
NODE_IPS="${NODE_IPS:-}"
MAX_BANDWIDTH_BPS="${MAX_BANDWIDTH_BPS:-200000000}"
ENV_FILE=""
AWG_PORT=51820
AWG_MOBILE_PORT=8443
AWG_VERSION="${AWG_VERSION:-3.1}"
AWG_MOBILE_VERSION="${AWG_MOBILE_VERSION:-}"
FORCE_AWG_CONF=0
WG_PORT="${WG_PORT:-51820}"
WG_NETWORK="${WG_NETWORK:-10.100.0.0/16}"
WG_ADDRESS="${WG_ADDRESS:-10.100.0.1/16}"
FORCE_WG_CONF=0

log() { printf '[frkn-install] %s\n' "$*" >&2; }
die() { printf '[frkn-install] ERROR: %s\n' "$*" >&2; exit 1; }

is_shared_env() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    dev|development|ru|wl|prod|production|experimental|exp|gaming) return 0 ;;
    *) return 1 ;;
  esac
}

is_personal_env() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    personal*|custompersonal*) return 0 ;;
    *) return 1 ;;
  esac
}

is_ipv4() {
  local n
  [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  for n in "${BASH_REMATCH[@]:1}"; do
    ((10#$n <= 255)) || return 1
  done
}

is_public_ipv4() {
  local second
  is_ipv4 "$1" || return 1
  [[ "$1" == 10.* || "$1" == 127.* || "$1" == 192.168.* || "$1" == 169.254.* ]] && return 1
  if [[ "$1" == 172.* ]]; then
    second="${1#172.}"
    second="${second%%.*}"
    if ((10#$second >= 16 && 10#$second <= 31)); then
      return 1
    fi
  fi
  if [[ "$1" == 100.* ]]; then
    second="${1#100.}"
    second="${second%%.*}"
    if ((10#$second >= 64 && 10#$second <= 127)); then
      return 1
    fi
  fi
}

ip_in_node_list() {
  local have
  for have in "${NODE_IP_LIST[@]}"; do
    [[ "$have" == "$1" ]] && return 0
  done
  return 1
}

format_node_ips() {
  local out="" ip
  for ip in "$@"; do
    [[ -n "$out" ]] && out+=", "
    out+="\"$ip\""
  done
  printf '%s' "$out"
}

collect_node_ips() {
  local ip extra
  NODE_IP_LIST=("$DEFAULT_IP")
  while read -r ip; do
    [[ -z "$ip" || "$ip" == "$DEFAULT_IP" ]] && continue
    is_public_ipv4 "$ip" || continue
    ip_in_node_list "$ip" && continue
    NODE_IP_LIST+=("$ip")
  done < <(ip -4 -o addr show scope global | awk '{print $4}' | cut -d/ -f1)
  extra="${NODE_IPS//,/ }"
  [[ -z "${extra// }" ]] && return 0
  local -a extra_ips=()
  read -r -a extra_ips <<< "$extra"
  for ip in "${extra_ips[@]}"; do
    is_ipv4 "$ip" || die "bad IP in --ips: $ip"
    ip_in_node_list "$ip" && continue
    NODE_IP_LIST+=("$ip")
  done
}

frkn_install_self_check() {
  is_ipv4 1.2.3.4 || die "self-check: 1.2.3.4"
  is_ipv4 999.1.1.1 && die "self-check: 999 should fail"
  is_public_ipv4 8.8.8.8 || die "self-check: 8.8.8.8"
  is_public_ipv4 10.1.1.1 && die "self-check: 10"
  is_public_ipv4 172.16.0.1 && die "self-check: 172.16"
  is_public_ipv4 172.32.0.1 || die "self-check: 172.32"
  is_public_ipv4 192.168.0.1 && die "self-check: 192.168"
  is_public_ipv4 100.64.0.1 && die "self-check: cgnat low"
  is_public_ipv4 100.127.1.1 && die "self-check: cgnat high"
  is_public_ipv4 100.63.1.1 || die "self-check: 100.63"
  is_public_ipv4 100.128.0.1 || die "self-check: 100.128"
  is_public_ipv4 169.254.1.1 && die "self-check: linklocal"
  [[ "$(format_node_ips 1.1.1.1 8.8.8.8)" == '"1.1.1.1", "8.8.8.8"' ]] || die "self-check: format"
  log "self-check ok"
}

if [[ "${FRKN_INSTALL_SELF_CHECK:-}" == 1 ]]; then
  frkn_install_self_check
  exit 0
fi

print_banner() {
  local kind="$1"
  local label
  case "$kind" in
    private) label="PRIVATE" ;;
    core) label="CORE" ;;
    premium) label="PREMIUM" ;;
    *) label="$(printf '%s' "$kind" | tr '[:lower:]' '[:upper:]')" ;;
  esac
  label="$(printf '%-7s' "$label")"
  local Y=$'\033[1;33m' N=$'\033[0m'
  echo -e "${Y}"
  cat <<EOF
//
//    ${label}           __      _
//                     / _|    | |
//                    | |_ _ __| | ___ __
//      _____      _  |  _| '__| |/ / '_ \\
//     |  __ \\    (_) | | | |  |   <| | | |
//     | |__) | __ __ |_|_|_| _|_|\\_\\_| |_|
//     |  ___/ '__| \\ \\ / / _\` |/ __| | | |
//     | |   | |  | |\\ V / (_| | (__| |_| |
//     |_|___|_|  |_| \\_/ \\__,_|\\___|\\__, |
//      / ____|                       __/ |
//     | |     ___  _ __ ___  _ __   |___/_ __  _   _
//     | |    / _ \\| '_ \` _ \\| '_ \\ / _\` | '_ \\| | | |
//     | |___| (_) | | | | | | |_) | (_| | | | | |_| |
//      \\_____\\___/|_| |_| |_| .__/ \\__,_|_| |_|\\__, |
//                           | |                 __/ |
//                           |_|                |___/
EOF
  echo -e "${N}"
}

write_logo_sh() {
  local kind="$1"
  local label
  case "$kind" in
    private) label="PRIVATE" ;;
    core) label="CORE" ;;
    premium) label="PREMIUM" ;;
    *) label="PREMIUM" ;;
  esac
  label="$(printf '%-7s' "$label")"
  cat > /root/.logo.sh << EOF
#!/bin/bash
YELLOW='\033[1;33m'
NC='\033[0m'
echo -e "\${YELLOW}"
cat << 'BANNER'
//
//    ${label}           __      _
//                     / _|    | |
//                    | |_ _ __| | ___ __
//      _____      _  |  _| '__| |/ / '_ \\
//     |  __ \\    (_) | | | |  |   <| | | |
//     | |__) | __ __ |_|_|_| _|_|\\_\\_| |_|
//     |  ___/ '__| \\ \\ / / _\` |/ __| | | |
//     | |   | |  | |\\ V / (_| | (__| |_| |
//     |_|___|_|  |_| \\_/ \\__,_|\\___|\\__, |
//      / ____|                       __/ |
//     | |     ___  _ __ ___  _ __   |___/_ __  _   _
//     | |    / _ \\| '_ \` _ \\| '_ \\ / _\` | '_ \\| | | |
//     | |___| (_) | | | | | | |_) | (_| | | | | |_| |
//      \\_____\\___/|_| |_| |_| .__/ \\__,_|_| |_|\\__, |
//                           | |                 __/ |
//                           |_|                |___/
BANNER
echo -e "\${NC}"
EOF
  chmod +x /root/.logo.sh
  touch /root/.hushlogin
  grep -qxF 'source ~/.logo.sh' /root/.bashrc 2>/dev/null || echo 'source ~/.logo.sh' >> /root/.bashrc
  grep -qxF 'source ~/.env' /root/.bashrc 2>/dev/null || echo 'source ~/.env' >> /root/.bashrc
  if ! grep -q 'PS1=.*ENV' /root/.bashrc 2>/dev/null; then
    echo 'export PS1="[${ENV} $HOSTNAME ] λ "' >> /root/.bashrc
  fi
}

usage() {
  cat <<'EOF'
FRKN node installer (Ubuntu or Arch).

Private:
  curl -fsSL https://frkn.org/install | bash -s -- --token inst_… [--profile full|awg|wg|hysteria2]

Core (shared fleet env):
  curl -fsSL https://frkn.org/install | bash -s -- --api-token … --env dev --profile full \
    [--label SWE2] [--country SWE] [--uuid …] [--env-file path]

Core WireGuard-only (routing experiments):
  curl -fsSL https://frkn.org/install | bash -s -- --api-token … --env ru --profile wg \
    --label 'MSK TW' --country RU --hostname msk-tw.frkn.org

Premium (managed scope env, same API service token):
  curl -fsSL https://frkn.org/install | bash -s -- --api-token … --env customSCOPE \
    --profile full [--label …] [--country …] [--uuid …]

Flags:
  --token TOKEN          private install token (inst_…)
  --api-token TOKEN      API service token (core or premium)
  --profile NAME         full | awg | wg | hysteria2  (default: full)
                         full = awg0+awg1+hysteria2 (no WireGuard);
                         wg = plain WireGuard only
  --env NAME             core: dev|ru|wl|…  / premium: custom… scope env
  --label TEXT           node label (required for core/premium; private default: CC| Private)
  --country CC           country code (default: detect from egress IP, else XX)
  --uuid UUID            reuse node uuid
  --hostname NAME        override hostname (ACME / node.hostname)
  --ips IP,IP            extra entry IPv4s (primary stays the default-route address)
  --awg-version VER      3.1 (default) | 2.0 | 1.0 — obfuscation for awg0+awg1
                         1.0 = legacy (H1..H4=1..4, S1/S2 only)
  --awg-mobile-version V override awg1 only: 3.1 | 2.0 | 1.0 | legacy
  --force-awg-conf       regenerate /opt/amnezia/awg{0,1}.conf (new junk → refresh client sub)
  --wg-port PORT         WireGuard ListenPort (default: 51820)
  --force-wg-conf        regenerate /opt/wireguard/wg0.conf
  --env-file PATH        source KEY=VALUE file before parsing flags
  --help                 this help

Re-run is idempotent: existing awg/wg/hysteria configs and node uuid are kept;
private mode reuses /opt/fnode/api.token when present. Pass --force-awg-conf
only when switching --awg-version (then restart fnode and fully refresh the
client subscription — old junk = Unknown message / Invalid MAC).
EOF
}

load_env_file() {
  local f="$1"
  [[ -f "$f" ]] || die "env file not found: $f"
  set -a
  # shellcheck disable=SC1090
  source "$f"
  set +a
  INSTALL_TOKEN="${INSTALL_TOKEN:-${FRKN_INSTALL_TOKEN:-${TOKEN:-}}}"
  API_TOKEN="${API_TOKEN:-${FRKN_API_TOKEN:-}}"
  ENV_NAME="${ENV:-$ENV_NAME}"
  PROFILE="${PROFILE:-full}"
  LABEL="${LABEL:-}"
  COUNTRY="${COUNTRY:-}"
  NODE_UUID="${UUID:-$NODE_UUID}"
  HOSTNAME_OVERRIDE="${HOSTNAME_OVERRIDE:-${NODE_HOSTNAME:-}}"
  AWG_VERSION="${AWG_VERSION:-3.1}"
  AWG_MOBILE_VERSION="${AWG_MOBILE_VERSION:-}"
  FORCE_AWG_CONF="${FORCE_AWG_CONF:-0}"
  WG_PORT="${WG_PORT:-51820}"
  WG_NETWORK="${WG_NETWORK:-10.100.0.0/16}"
  WG_ADDRESS="${WG_ADDRESS:-10.100.0.1/16}"
  FORCE_WG_CONF="${FORCE_WG_CONF:-0}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --token) INSTALL_TOKEN="$2"; shift 2 ;;
    --api-token) API_TOKEN="$2"; shift 2 ;;
    --profile) PROFILE="$2"; shift 2 ;;
    --env) ENV_NAME="$2"; shift 2 ;;
    --label) LABEL="$2"; shift 2 ;;
    --country) COUNTRY="$2"; shift 2 ;;
    --uuid) NODE_UUID="$2"; shift 2 ;;
    --hostname) HOSTNAME_OVERRIDE="$2"; shift 2 ;;
    --ips) NODE_IPS="$2"; shift 2 ;;
    --awg-version) AWG_VERSION="$2"; shift 2 ;;
    --awg-mobile-version) AWG_MOBILE_VERSION="$2"; shift 2 ;;
    --force-awg-conf) FORCE_AWG_CONF=1; shift ;;
    --wg-port) WG_PORT="$2"; shift 2 ;;
    --force-wg-conf) FORCE_WG_CONF=1; shift ;;
    --env-file) ENV_FILE="$2"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) die "unknown arg: $1 (see --help)" ;;
  esac
done

if [[ -n "$ENV_FILE" ]]; then
  load_env_file "$ENV_FILE"
fi

case "$PROFILE" in
  full|awg|wg|hysteria2) ;;
  amnezia) PROFILE="awg" ;;
  wireguard) PROFILE="wg" ;;
  *) die "profile must be full|awg|wg|hysteria2" ;;
esac

case "$AWG_VERSION" in
  3.1|2.0|legacy) ;;
  3) AWG_VERSION="3.1" ;;
  2) AWG_VERSION="2.0" ;;
  1.0|1) AWG_VERSION="legacy" ;;
  *) die "--awg-version must be 3.1, 2.0 or 1.0 (got $AWG_VERSION)" ;;
esac
if [[ -z "$AWG_MOBILE_VERSION" ]]; then
  AWG_MOBILE_VERSION="$AWG_VERSION"
fi
case "$AWG_MOBILE_VERSION" in
  3.1|2.0|legacy) ;;
  3) AWG_MOBILE_VERSION="3.1" ;;
  2) AWG_MOBILE_VERSION="2.0" ;;
  1.0|1) AWG_MOBILE_VERSION="legacy" ;;
  *) die "--awg-mobile-version must be 3.1|2.0|1.0|legacy (got $AWG_MOBILE_VERSION)" ;;
esac

if [[ -n "$INSTALL_TOKEN" && -n "$API_TOKEN" ]]; then
  die "--token and --api-token are mutually exclusive"
fi
if [[ -n "$INSTALL_TOKEN" ]]; then
  MODE="private"
  [[ "$INSTALL_TOKEN" == inst_* ]] || die "private token must start with inst_"
elif [[ -n "$API_TOKEN" ]]; then
  [[ -n "$ENV_NAME" ]] || die "--api-token requires --env"
  if is_personal_env "$ENV_NAME"; then
    die "personal env needs --token inst_… (private), not --api-token"
  fi
  if is_shared_env "$ENV_NAME"; then
    MODE="core"
  else
    MODE="premium"
  fi
elif [[ -f /opt/fnode/api.token && -s /opt/fnode/api.token ]]; then
  MODE="private"
  log "no --token: reusing existing private install (/opt/fnode/api.token)"
else
  die "pass --token inst_… (private) or --api-token … (core|premium)"
fi

print_banner "$MODE"

[[ $EUID -eq 0 ]] || die "run as root"

write_logo_sh "$MODE"

if [[ ! -f /etc/os-release ]]; then
  die "cannot detect OS"
fi
# shellcheck disable=SC1091
source /etc/os-release
if [[ "${ID:-}" == "ubuntu" ]]; then
  OS_FAMILY="debian"
  UBUNTU_CODENAME="${VERSION_CODENAME:-}"
  case "$UBUNTU_CODENAME" in
    focal|jammy|noble|resolute) PPA_CODENAME="$UBUNTU_CODENAME" ;;
    *) PPA_CODENAME="noble"; log "WARN: falling back to noble PPA for $UBUNTU_CODENAME" ;;
  esac
  export DEBIAN_FRONTEND=noninteractive
elif [[ "${ID:-}" == "arch" || ",${ID_LIKE:-}," == *,arch,* ]]; then
  OS_FAMILY="arch"
else
  die "Ubuntu or Arch only (got ${ID:-unknown})"
fi

NODE_HOST="${HOSTNAME_OVERRIDE:-$(hostname -f 2>/dev/null || hostname)}"
if [[ -z "$NODE_UUID" && -f /root/.env ]]; then
  NODE_UUID="$(grep -E '^UUID=' /root/.env 2>/dev/null | head -n1 | cut -d= -f2- | tr -d '[:space:]"')"
fi
if [[ -z "$NODE_UUID" && -f /opt/fnode/config.toml ]]; then
  NODE_UUID="$(grep -E '^[[:space:]]*uuid[[:space:]]*=' /opt/fnode/config.toml 2>/dev/null | head -n1 | sed -E 's/.*=[[:space:]]*"?([^"]*)"?[[:space:]]*$/\1/' | tr -d '[:space:]')"
fi
if [[ -z "$NODE_UUID" ]]; then
  if command -v uuidgen >/dev/null 2>&1; then
    NODE_UUID="$(uuidgen | tr '[:upper:]' '[:lower:]')"
  else
    NODE_UUID="$(cat /proc/sys/kernel/random/uuid)"
  fi
else
  log "reusing node uuid $NODE_UUID"
fi
if [[ "$MODE" != "private" && -z "$LABEL" ]]; then
  die "--label is required for core and premium"
fi

DEFAULT_IFACE="$(ip route get 1.1.1.1 2>/dev/null | awk '/dev/ {for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')"
[[ -n "$DEFAULT_IFACE" ]] || die "cannot detect default interface"
DEFAULT_IP="$(ip -o -4 addr show dev "$DEFAULT_IFACE" | awk '{print $4}' | cut -d/ -f1 | head -n1)"
[[ -n "$DEFAULT_IP" ]] || die "cannot detect IPv4 on $DEFAULT_IFACE"
is_ipv4 "$DEFAULT_IP" || die "default address is not IPv4: $DEFAULT_IP"
collect_node_ips

CORES="$(nproc 2>/dev/null || echo 1)"
NEED_AWG=0
NEED_WG=0
NEED_H2=0
case "$PROFILE" in
  full) NEED_AWG=1; NEED_H2=1 ;;
  awg) NEED_AWG=1 ;;
  wg) NEED_WG=1 ;;
  hysteria2) NEED_H2=1 ;;
esac

log "os=$OS_FAMILY mode=$MODE profile=$PROFILE awg=$AWG_VERSION mobile=$AWG_MOBILE_VERSION wg_port=$WG_PORT host=$NODE_HOST ip=$DEFAULT_IP ips=${NODE_IP_LIST[*]} iface=$DEFAULT_IFACE uuid=$NODE_UUID"

arch_kernel_headers() {
  case "$(uname -r)" in
    *-lts*) echo linux-lts-headers ;;
    *-zen*) echo linux-zen-headers ;;
    *-hardened*) echo linux-hardened-headers ;;
    *) echo linux-headers ;;
  esac
}

arch_aur_install() {
  local pkgname="$1" tmpdir pkgfile
  if pacman -Qi "$pkgname" &>/dev/null; then
    log "$pkgname already installed"
    return 0
  fi
  log "building $pkgname from AUR…"
  tmpdir="$(mktemp -d)"
  if id aur_builder &>/dev/null; then
    userdel aur_builder 2>/dev/null || true
  fi
  useradd -r -d "$tmpdir" -s /bin/bash aur_builder
  chown -R aur_builder:aur_builder "$tmpdir"
  if ! su -s /bin/bash aur_builder -c "cd '$tmpdir' && git clone --depth 1 'https://aur.archlinux.org/${pkgname}.git' && cd '${pkgname}' && makepkg --noconfirm"; then
    userdel aur_builder 2>/dev/null || true
    rm -rf "$tmpdir"
    die "failed to build $pkgname from AUR"
  fi
  pkgfile="$(find "$tmpdir/$pkgname" -name '*.pkg.tar.*' ! -name '*-debug-*' | head -n1)"
  if [[ -z "$pkgfile" ]]; then
    userdel aur_builder 2>/dev/null || true
    rm -rf "$tmpdir"
    die "no package file for $pkgname"
  fi
  pacman -U --noconfirm "$pkgfile"
  userdel aur_builder 2>/dev/null || true
  rm -rf "$tmpdir"
}

detect_country() {
  local body loc
  body="$(curl -fsS --max-time 8 https://1.1.1.1/cdn-cgi/trace 2>/dev/null || true)"
  loc="$(printf '%s\n' "$body" | awk -F= '$1=="loc"{print $2; exit}')"
  loc="$(printf '%s' "$loc" | tr '[:lower:]' '[:upper:]' | tr -cd 'A-Z')"
  if [[ ${#loc} -eq 2 ]]; then
    printf '%s' "$loc"
    return 0
  fi
  loc="$(curl -fsS --max-time 8 https://ipinfo.io/country 2>/dev/null || true)"
  loc="$(printf '%s' "$loc" | tr '[:lower:]' '[:upper:]' | tr -cd 'A-Z')"
  if [[ ${#loc} -eq 2 ]]; then
    printf '%s' "$loc"
    return 0
  fi
  return 1
}

ensure_country() {
  if [[ -n "$COUNTRY" ]]; then
    COUNTRY="$(printf '%s' "$COUNTRY" | tr '[:lower:]' '[:upper:]' | tr -cd 'A-Z')"
    [[ -n "$COUNTRY" ]] || die "--country is empty"
    return
  fi
  if COUNTRY="$(detect_country)"; then
    log "detected country $COUNTRY"
    return
  fi
  COUNTRY="XX"
  log "WARN: country detect failed, using XX"
}

install_base_packages() {
  if [[ "$OS_FAMILY" == "arch" ]]; then
    pacman -Sy --noconfirm --needed \
      curl ca-certificates iptables iproute2 jq openssl unzip net-tools \
      git base-devel
    return
  fi
  apt-get update -y
  apt-get install -y curl ca-certificates gnupg software-properties-common \
    iptables iproute2 uuid-runtime jq openssl unzip net-tools
}

rand_between() {
  local min="$1" max="$2"
  echo $((RANDOM % (max - min + 1) + min))
}

is_kernel_meta() {
  case "$1" in
    linux-generic|linux-virtual|linux-image-generic|linux-headers-generic|linux-image-virtual|linux-headers-virtual)
      return 0 ;;
    linux-generic-hwe-*|linux-image-generic-hwe-*|linux-headers-generic-hwe-*|linux-modules-generic-hwe-*)
      return 0 ;;
    *)
      return 1 ;;
  esac
}

amneziawg_for_kernel() {
  modinfo -n -k "$1" amneziawg &>/dev/null
}

pin_ubuntu_kernel() {
  local kver pkg
  local -a hold=()
  kver="$(uname -r)"
  while IFS= read -r pkg; do
    [[ -n "$pkg" ]] || continue
    is_kernel_meta "$pkg" || continue
    hold+=("$pkg")
  done < <(dpkg-query -W -f='${Status} ${Package}\n' 2>/dev/null | awk '/^install ok installed /{print $NF}')
  for pkg in "linux-image-${kver}" "linux-headers-${kver}" "linux-modules-${kver}"; do
    if dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed'; then
      hold+=("$pkg")
    fi
  done
  if ((${#hold[@]} > 0)); then
    apt-mark hold "${hold[@]}" >/dev/null
    log "held kernel: ${hold[*]}"
  else
    log "WARN: no kernel packages to hold"
  fi
  cat >/etc/apt/apt.conf.d/99frkn-kernel <<'EOF'
Unattended-Upgrade::Package-Blacklist {
    "linux-generic";
    "linux-headers";
    "linux-image";
    "linux-modules";
    "linux-virtual";
};
Unattended-Upgrade::Remove-Unused-Kernel-Packages "false";
EOF
}

ensure_amneziawg_kernels() {
  local img ver
  for img in /boot/vmlinuz-*; do
    [[ -f "$img" ]] || continue
    ver="${img#/boot/vmlinuz-}"
    amneziawg_for_kernel "$ver" && continue
    log "building amneziawg for $ver"
    if ! apt-get install -y "linux-headers-${ver}"; then
      log "WARN: headers missing for $ver"
      continue
    fi
    dkms autoinstall -k "$ver" || log "WARN: dkms failed for $ver"
  done
}

grub_entry_id() {
  local ver="$1" line
  [[ -f /boot/grub/grub.cfg ]] || return 1
  line="$(grep -F "gnulinux-${ver}-advanced-" /boot/grub/grub.cfg | head -n1 || true)"
  [[ -n "$line" ]] || return 1
  printf '%s\n' "$line" | sed -n "s/.*'\(gnulinux-[^']*\)'.*/\1/p"
}

pin_grub_if_module_missing() {
  local img ver id unsafe=0
  ver="$(uname -r)"
  for img in /boot/vmlinuz-*; do
    [[ -f "$img" ]] || continue
    amneziawg_for_kernel "${img#/boot/vmlinuz-}" && continue
    unsafe=1
    log "WARN: no amneziawg module for ${img#/boot/vmlinuz-}"
  done
  if [[ "$unsafe" -eq 0 ]]; then
    log "amneziawg module present for every installed kernel"
    return 0
  fi
  amneziawg_for_kernel "$ver" || {
    log "WARN: running kernel has no amneziawg module"
    return 0
  }
  [[ -f /etc/default/grub ]] || { log "WARN: no /etc/default/grub"; return 0; }
  command -v update-grub >/dev/null || { log "WARN: no update-grub"; return 0; }
  command -v grub-set-default >/dev/null || { log "WARN: no grub-set-default"; return 0; }
  if grep -q '^GRUB_DEFAULT=' /etc/default/grub; then
    sed -i 's/^GRUB_DEFAULT=.*/GRUB_DEFAULT=saved/' /etc/default/grub
  else
    printf '\nGRUB_DEFAULT=saved\n' >> /etc/default/grub
  fi
  update-grub >/dev/null
  id="$(grub_entry_id "$ver" || true)"
  if [[ -z "$id" ]]; then
    log "WARN: grub entry for $ver not found"
    return 0
  fi
  grub-set-default "$id"
  log "grub pinned to $ver"
}

ignore_pkg_has() {
  [[ " $1 " == *" $2 "* ]]
}

pin_arch_kernel() {
  local headers kernel conf=/etc/pacman.conf line
  headers="$(arch_kernel_headers)"
  kernel="${headers%-headers}"
  if ! grep -q '^\[options\]' "$conf"; then
    log "WARN: no [options] in pacman.conf, kernel not pinned"
    return 0
  fi
  if grep -q '^IgnorePkg' "$conf"; then
    line="$(grep '^IgnorePkg' "$conf" | head -n1)"
    if ! ignore_pkg_has "$line" "$kernel"; then
      sed -i "s/^IgnorePkg.*/& ${kernel}/" "$conf"
    fi
    line="$(grep '^IgnorePkg' "$conf" | head -n1)"
    if ! ignore_pkg_has "$line" "$headers"; then
      sed -i "s/^IgnorePkg.*/& ${headers}/" "$conf"
    fi
  else
    sed -i "/^\[options\]/a IgnorePkg = ${kernel} ${headers}" "$conf"
  fi
  log "pacman IgnorePkg: ${kernel} ${headers}"
  dkms autoinstall || log "WARN: dkms autoinstall failed; reboot may miss amneziawg"
}

install_awg_boot_helper() {
  cat >/usr/local/sbin/frkn-awg-module <<'EOF'
#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
modprobe amneziawg 2>/dev/null && exit 0
k="$(uname -r)"
if command -v apt-get >/dev/null 2>&1; then
  apt-get install -y "linux-headers-${k}" dkms \
    || { apt-get update -y && apt-get install -y "linux-headers-${k}" dkms; }
elif command -v pacman >/dev/null 2>&1; then
  case "$k" in
    *-lts*) pacman -S --noconfirm --needed linux-lts-headers dkms ;;
    *-zen*) pacman -S --noconfirm --needed linux-zen-headers dkms ;;
    *-hardened*) pacman -S --noconfirm --needed linux-hardened-headers dkms ;;
    *) pacman -S --noconfirm --needed linux-headers dkms ;;
  esac
fi
dkms autoinstall -k "$k"
depmod -a
modprobe amneziawg
EOF
  chmod 755 /usr/local/sbin/frkn-awg-module
  mkdir -p /etc/systemd/system/awg-quick@.service.d
  cat >/etc/systemd/system/awg-quick@.service.d/frkn-module.conf <<'EOF'
[Service]
ExecStartPre=/usr/local/sbin/frkn-awg-module
TimeoutStartSec=300
EOF
  systemctl daemon-reload || true
}

pin_kernel_for_reboot() {
  if [[ "$OS_FAMILY" == "arch" ]]; then
    pin_arch_kernel
  else
    pin_ubuntu_kernel
    ensure_amneziawg_kernels
    pin_grub_if_module_missing
  fi
  install_awg_boot_helper
}

install_amneziawg() {
  log "installing AmneziaWG (desktop=${AWG_VERSION}, mobile=${AWG_MOBILE_VERSION})…"
  if [[ "$OS_FAMILY" == "arch" ]]; then
    local headers
    headers="$(arch_kernel_headers)"
    log "kernel headers package: $headers"
    pacman -S --noconfirm --needed "$headers" dkms openresolv bc \
      || die "failed to install $headers (headers must match the running kernel)"
    arch_aur_install amneziawg-tools
    arch_aur_install amneziawg-dkms
  else
    apt-get install -y "linux-headers-$(uname -r)" dkms \
      || die "need linux-headers-$(uname -r) and dkms"
    mkdir -p /etc/apt/keyrings
    if [[ ! -f /etc/apt/keyrings/amnezia.gpg ]]; then
      curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x57290828" \
        | gpg --dearmor --yes -o /etc/apt/keyrings/amnezia.gpg
    fi
    cat >/etc/apt/sources.list.d/amnezia.list <<EOF
deb [signed-by=/etc/apt/keyrings/amnezia.gpg] https://ppa.launchpadcontent.net/amnezia/ppa/ubuntu ${PPA_CODENAME} main
EOF
    apt-get update -y
    apt-get install -y amneziawg
  fi
  modprobe amneziawg || true
  cat >/etc/sysctl.d/99-amnezia.conf <<EOF
net.ipv4.ip_forward=1
net.ipv6.conf.all.forwarding=1
EOF
  sysctl --system >/dev/null || true

  mkdir -p /opt/amnezia /etc/amnezia/amneziawg
  command -v awg >/dev/null || die "awg not found after install"
  command -v awg-quick >/dev/null || die "awg-quick not found after install"

  write_awg0_conf
  write_awg1_conf
  printf 'desktop=%s\nmobile=%s\n' "$AWG_VERSION" "$AWG_MOBILE_VERSION" \
    >/opt/amnezia/.frkn-awg-version

  ln -sf /opt/amnezia/awg0.conf /etc/amnezia/amneziawg/awg0.conf
  ln -sf /opt/amnezia/awg1.conf /etc/amnezia/amneziawg/awg1.conf
  chmod 600 /opt/amnezia/awg0.conf /opt/amnezia/awg1.conf

  bring_up_awg awg0
  bring_up_awg awg1
  systemctl enable "awg-quick@awg0" "awg-quick@awg1" || true
  pin_kernel_for_reboot
}

bring_up_awg() {
  local iface="$1"
  awg-quick down "$iface" 2>/dev/null || true
  if ip link show "$iface" >/dev/null 2>&1; then
    log "removing leftover link $iface"
    ip link delete "$iface" 2>/dev/null || true
  fi
  awg-quick up "$iface"
}

bt_reject_rules() {
  local net="$1"
  printf '%s' "iptables -I FORWARD -s ${net} -m string --algo bm --string \"BitTorrent protocol\" -j REJECT; iptables -I FORWARD -d ${net} -m string --algo bm --string \"BitTorrent protocol\" -j REJECT; iptables -I FORWARD -s ${net} -p udp -m string --algo bm --string \"d1:ad2:id20:\" -j REJECT; iptables -I FORWARD -s ${net} -m string --algo bm --string \"info_hash\" -j REJECT; iptables -I FORWARD -s ${net} -m string --algo bm --string \"peer_id=\" -j REJECT"
}

bt_reject_teardown() {
  local net="$1"
  printf '%s' "iptables -D FORWARD -s ${net} -m string --algo bm --string \"BitTorrent protocol\" -j REJECT; iptables -D FORWARD -d ${net} -m string --algo bm --string \"BitTorrent protocol\" -j REJECT; iptables -D FORWARD -s ${net} -p udp -m string --algo bm --string \"d1:ad2:id20:\" -j REJECT; iptables -D FORWARD -s ${net} -m string --algo bm --string \"info_hash\" -j REJECT; iptables -D FORWARD -s ${net} -m string --algo bm --string \"peer_id=\" -j REJECT"
}

# Emit Jc.. obfuscation lines for the chosen generation.
# 3.1 = 2.0 field set + RandomTrailers/DisableCookies (needs 3.1+ module).
# 2.0 = S1–S4, H ranges, I1 — no 3.1 device flags.
# legacy = H1..H4 = 1..4, only S1/S2 (RU LTE / aggressive middleboxes).
awg_obfuscation_lines() {
  local ver="$1"
  local jc="$2" jmin="$3" jmax="$4" s1="$5" s2="$6" s3="$7" s4="$8"
  case "$ver" in
    legacy|1.0)
      cat <<EOF
Jc = ${jc}
Jmin = ${jmin}
Jmax = ${jmax}
S1 = ${s1}
S2 = ${s2}
H1 = 1
H2 = 2
H3 = 3
H4 = 4
EOF
      ;;
    2.0)
      cat <<EOF
Jc = ${jc}
Jmin = ${jmin}
Jmax = ${jmax}
S1 = ${s1}
S2 = ${s2}
S3 = ${s3}
S4 = ${s4}
H1 = 100000-200000
H2 = 300000-400000
H3 = 500000-600000
H4 = 700000-800000
I1 = <r 128>
EOF
      ;;
    3.1)
      cat <<EOF
Jc = ${jc}
Jmin = ${jmin}
Jmax = ${jmax}
S1 = ${s1}
S2 = ${s2}
S3 = ${s3}
S4 = ${s4}
H1 = 100000-200000
H2 = 300000-400000
H3 = 500000-600000
H4 = 700000-800000
I1 = <r 128>
RandomTrailers = on
DisableCookies = on
EOF
      ;;
    *) die "internal: bad awg version $ver" ;;
  esac
}

keep_or_regen_awg_conf() {
  local path="$1" label="$2"
  if [[ -f "$path" && "$FORCE_AWG_CONF" -ne 1 ]]; then
    log "${label} exists — keep (use --force-awg-conf to regenerate for --awg-version)"
    return 1
  fi
  if [[ -f "$path" && "$FORCE_AWG_CONF" -eq 1 ]]; then
    log "regenerating ${label} (--force-awg-conf); refresh client subscription after fnode restart"
  fi
  return 0
}

write_awg0_conf() {
  local priv jc jmin jmax s1 s2 s3 s4 bt_up bt_down
  keep_or_regen_awg_conf /opt/amnezia/awg0.conf awg0.conf || return 0
  priv="$(awg genkey)"
  jc="$(rand_between 3 8)"
  jmin="$(rand_between 40 70)"
  jmax="$(rand_between 90 150)"
  s1="$(rand_between 40 80)"
  s2="$(rand_between 40 80)"
  s3="$(rand_between 8 32)"
  s4="$(rand_between 8 24)"
  bt_up="$(bt_reject_rules "100.64.0.0/10")"
  bt_down="$(bt_reject_teardown "100.64.0.0/10")"
  cat >/opt/amnezia/awg0.conf <<EOF
[Interface]
PrivateKey = ${priv}
Address = 100.64.0.1/10
ListenPort = ${AWG_PORT}
MTU = 1280

PostUp = iptables -I FORWARD -i %i -j ACCEPT; iptables -t nat -A POSTROUTING -s 100.64.0.0/10 -o ${DEFAULT_IFACE} -j MASQUERADE; ${bt_up}
PostDown = iptables -D FORWARD -i %i -j ACCEPT; iptables -t nat -D POSTROUTING -s 100.64.0.0/10 -o ${DEFAULT_IFACE} -j MASQUERADE; ${bt_down}

$(awg_obfuscation_lines "$AWG_VERSION" "$jc" "$jmin" "$jmax" "$s1" "$s2" "$s3" "$s4")
EOF
}

write_awg1_conf() {
  local priv jc jmin jmax s1 s2 s3 s4 bt_up bt_down
  keep_or_regen_awg_conf /opt/amnezia/awg1.conf awg1.conf || return 0
  priv="$(awg genkey)"
  jc="$(rand_between 5 9)"
  jmin="$(rand_between 40 70)"
  jmax="$(rand_between 90 160)"
  s1="$(rand_between 30 60)"
  s2="$(rand_between 40 70)"
  s3="$(rand_between 8 24)"
  s4="$(rand_between 8 24)"
  bt_up="$(bt_reject_rules "10.77.0.0/16")"
  bt_down="$(bt_reject_teardown "10.77.0.0/16")"
  cat >/opt/amnezia/awg1.conf <<EOF
[Interface]
PrivateKey = ${priv}
Address = 10.77.0.1/16
ListenPort = ${AWG_MOBILE_PORT}
MTU = 1280

PostUp = iptables -I FORWARD -i %i -j ACCEPT; iptables -t nat -A POSTROUTING -s 10.77.0.0/16 -o ${DEFAULT_IFACE} -j MASQUERADE; ${bt_up}
PostDown = iptables -D FORWARD -i %i -j ACCEPT; iptables -t nat -D POSTROUTING -s 10.77.0.0/16 -o ${DEFAULT_IFACE} -j MASQUERADE; ${bt_down}

$(awg_obfuscation_lines "$AWG_MOBILE_VERSION" "$jc" "$jmin" "$jmax" "$s1" "$s2" "$s3" "$s4")
EOF
}

keep_or_regen_wg_conf() {
  local path="$1" label="$2"
  if [[ -f "$path" && "$FORCE_WG_CONF" -ne 1 ]]; then
    log "${label} exists — keep (use --force-wg-conf to regenerate)"
    return 1
  fi
  if [[ -f "$path" && "$FORCE_WG_CONF" -eq 1 ]]; then
    log "regenerating ${label} (--force-wg-conf); refresh client subscription after fnode restart"
  fi
  return 0
}

write_wg0_conf() {
  local priv bt_up bt_down
  keep_or_regen_wg_conf /opt/wireguard/wg0.conf wg0.conf || return 0
  priv="$(wg genkey)"
  bt_up="$(bt_reject_rules "${WG_NETWORK}")"
  bt_down="$(bt_reject_teardown "${WG_NETWORK}")"
  cat >/opt/wireguard/wg0.conf <<EOF
[Interface]
PrivateKey = ${priv}
Address = ${WG_ADDRESS}
ListenPort = ${WG_PORT}
MTU = 1280

PostUp = iptables -I FORWARD -i %i -j ACCEPT; iptables -t nat -A POSTROUTING -s ${WG_NETWORK} -o ${DEFAULT_IFACE} -j MASQUERADE; ${bt_up}
PostDown = iptables -D FORWARD -i %i -j ACCEPT; iptables -t nat -D POSTROUTING -s ${WG_NETWORK} -o ${DEFAULT_IFACE} -j MASQUERADE; ${bt_down}
EOF
}

bring_up_wg() {
  local iface="$1"
  wg-quick down "$iface" 2>/dev/null || true
  if ip link show "$iface" >/dev/null 2>&1; then
    log "removing leftover link $iface"
    ip link delete "$iface" 2>/dev/null || true
  fi
  wg-quick up "$iface"
}

install_wireguard() {
  log "installing WireGuard (port=${WG_PORT}, net=${WG_NETWORK})…"
  if [[ "$OS_FAMILY" == "arch" ]]; then
    pacman -S --noconfirm --needed wireguard-tools \
      || die "failed to install wireguard-tools"
  else
    apt-get install -y wireguard wireguard-tools \
      || die "failed to install wireguard"
  fi
  modprobe wireguard || true
  cat >/etc/sysctl.d/99-frkn-forward.conf <<EOF
net.ipv4.ip_forward=1
net.ipv6.conf.all.forwarding=1
EOF
  sysctl --system >/dev/null || true

  mkdir -p /opt/wireguard /etc/wireguard
  command -v wg >/dev/null || die "wg not found after install"
  command -v wg-quick >/dev/null || die "wg-quick not found after install"

  write_wg0_conf
  ln -sf /opt/wireguard/wg0.conf /etc/wireguard/wg0.conf
  chmod 600 /opt/wireguard/wg0.conf

  bring_up_wg wg0
  systemctl enable "wg-quick@wg0" || true
}

install_hysteria2() {
  log "installing Hysteria2…"
  local arch bin
  case "$(uname -m)" in
    x86_64) arch="amd64" ;;
    aarch64) arch="arm64" ;;
    armv7l) arch="armv7" ;;
    *) die "unsupported arch for hysteria2: $(uname -m)" ;;
  esac
  mkdir -p /opt/hysteria2
  if ! id hysteria2 >/dev/null 2>&1; then
    useradd -r -s /bin/false -M hysteria2 || true
  fi
  bin="/opt/hysteria2/hysteria"
  curl -fsSL -o "$bin" "https://github.com/apernet/hysteria/releases/latest/download/hysteria-linux-${arch}"
  chmod +x "$bin"
  if [[ ! -f /opt/hysteria2/config.yaml ]]; then
    cat >/opt/hysteria2/config.yaml <<EOF
listen: :443

acme:
  domains:
    - ${NODE_HOST}
  email: ${ACME_EMAIL}

auth:
  type: http
  http:
    url: ${HTTP_AUTH_URL}

masquerade:
  type: proxy
  proxy:
    url: https://www.microsoft.com/
    rewriteHost: true
EOF
  fi
  chown -R hysteria2:hysteria2 /opt/hysteria2
  cat >/etc/systemd/system/hysteria2.service <<EOF
[Unit]
Description=Hysteria 2
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/hysteria2
ExecStart=/opt/hysteria2/hysteria server -c /opt/hysteria2/config.yaml
Restart=always
RestartSec=5
LimitNOFILE=1048576
User=hysteria2
Group=hysteria2
Environment=HYSTERIA_LOG_LEVEL=info
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable hysteria2
  systemctl restart hysteria2
}

detect_arch_fnode() {
  case "$(uname -m)" in
    x86_64|amd64) echo "x86_64" ;;
    aarch64|arm64) echo "aarch64" ;;
    *) die "unsupported arch for fnode: $(uname -m)" ;;
  esac
}

write_root_env() {
  local token="$1"
  cat >/root/.env <<EOF
FRKN_MODE=${MODE}
FRKN_PROFILE=${PROFILE}
FRKN_INSTALL_VERSION=${FRKN_INSTALL_VERSION}
AWG_VERSION=${AWG_VERSION}
AWG_MOBILE_VERSION=${AWG_MOBILE_VERSION}
WG_PORT=${WG_PORT}
WG_NETWORK=${WG_NETWORK}
WG_ADDRESS=${WG_ADDRESS}
API_ENDPOINT=${API_ENDPOINT}
API_TOKEN=${token}
ZMQ_ENDPOINT=${ZMQ_ENDPOINT}
METRICS_ZMQ_ENDPOINT=${METRICS_ZMQ_ENDPOINT}
ENV=${ENV_NAME}
UUID=${NODE_UUID}
HOSTNAME=${NODE_HOST}
ADDRESS=${DEFAULT_IP}
NODE_IPS=${NODE_IP_LIST[*]}
INTERFACE=${DEFAULT_IFACE}
LABEL='${LABEL}'
COUNTRY=${COUNTRY}
MAX_BANDWIDTH_BPS=${MAX_BANDWIDTH_BPS}
EOF
  chmod 600 /root/.env
  if [[ -f /opt/fnode/.env ]]; then
    cp /root/.env /opt/fnode/.env
  else
    mkdir -p /opt/fnode
    cp /root/.env /opt/fnode/.env
  fi
}

write_fnode_config() {
  local token="$1"
  local awg_en=false awg_m_en=false wg_en=false h2_en=false
  local toml_env="$ENV_NAME"
  if [[ "$MODE" == "premium" && "$toml_env" == custom* ]]; then
    toml_env="${toml_env#custom}"
  fi
  [[ "$NEED_AWG" -eq 1 ]] && awg_en=true && awg_m_en=true
  [[ "$NEED_WG" -eq 1 ]] && wg_en=true
  [[ "$NEED_H2" -eq 1 ]] && h2_en=true
  mkdir -p /opt/fnode/snapshots
  cat >/opt/fnode/config.toml <<EOF
[service]
snapshot_interval = 60
snapshot_path = "snapshots/snapshot-agent.bin"
log_velel = "debug"
updates_endpoint_zmq = "${ZMQ_ENDPOINT}"

[metrics]
interval = 10
publisher = "${METRICS_ZMQ_ENDPOINT}"
endpoint = "127.0.0.1:3000"

[xray]
enabled = false
path = "/opt/xray/xray-config.json"

[h2]
enabled = ${h2_en}
path = "/opt/hysteria2/config.yaml"

[wg]
enabled = ${wg_en}
path = "/opt/wireguard/wg0.conf"

[awg]
enabled = ${awg_en}
path = "/opt/amnezia/awg0.conf"

[awg_mobile]
enabled = ${awg_m_en}
path = "/opt/amnezia/awg1.conf"
keepalive = 15

[mtproto]
enabled = false
path = "/opt/teleproxy/config.toml"

[node]
env = "${toml_env}"
uuid = "${NODE_UUID}"
hostname = "${NODE_HOST}"
default_interface = "${DEFAULT_IFACE}"
address = "${DEFAULT_IP}"
label = "${LABEL}"
max_bandwidth_bps = ${MAX_BANDWIDTH_BPS}
country = "${COUNTRY}"
type = "common"
node_ips = [$(format_node_ips "${NODE_IP_LIST[@]}")]

[api]
endpoint = "${API_ENDPOINT}"
token = "${token}"
EOF
}

install_fnode() {
  local token="$1"
  local arch
  arch="$(detect_arch_fnode)"
  log "installing fnode ${FNODE_VERSION} (${arch})…"
  mkdir -p /opt/fnode/snapshots
  curl -fsSL -o /opt/fnode/fnode \
    "https://github.com/frkn-dev/fcore/releases/download/${FNODE_VERSION}/node-${arch}"
  chmod +x /opt/fnode/fnode
  write_fnode_config "$token"
  write_root_env "$token"
  cat >/etc/systemd/system/fnode.service <<EOF
[Unit]
Description=Fnode
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/fnode/fnode /opt/fnode/config.toml
Restart=on-failure
RestartSec=5
WorkingDirectory=/opt/fnode

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable fnode
  systemctl restart fnode
}

private_register_and_token() {
  if [[ -f /opt/fnode/api.token && -s /opt/fnode/api.token ]]; then
    local existing
    existing="$(tr -d '[:space:]' </opt/fnode/api.token)"
    if [[ -n "$existing" ]]; then
      log "private mode: reusing /opt/fnode/api.token (idempotent re-run)"
      printf '%s\n' "$existing"
      return
    fi
  fi
  [[ -n "$INSTALL_TOKEN" ]] || die "private re-run needs /opt/fnode/api.token or a fresh --token inst_…"
  log "private mode: fnode will POST /private/nodes with install token, then persist node_token"
  printf '%s\n' "$INSTALL_TOKEN"
}

main() {
  install_base_packages
  ensure_country
  if [[ "$MODE" == "private" && -z "$LABEL" ]]; then
    LABEL="${COUNTRY}| Private"
  fi
  if [[ "$NEED_AWG" -eq 1 ]]; then
    install_amneziawg
  fi
  if [[ "$NEED_WG" -eq 1 ]]; then
    install_wireguard
  fi
  if [[ "$NEED_H2" -eq 1 ]]; then
    install_hysteria2
  fi

  local runtime_token
  case "$MODE" in
    core|premium)
      runtime_token="$API_TOKEN"
      ;;
    private)
      runtime_token="$(private_register_and_token)"
      ENV_NAME="dev"
      ;;
  esac

  install_fnode "$runtime_token"

  log "done. mode=$MODE profile=$PROFILE env=$ENV_NAME country=$COUNTRY awg=$AWG_VERSION mobile=$AWG_MOBILE_VERSION wg=$NEED_WG"
  log "fnode: systemctl status fnode"
  [[ "$NEED_AWG" -eq 1 ]] && log "awg: awg show awg0; awg show awg1"
  [[ "$NEED_WG" -eq 1 ]] && log "wg: wg show wg0"
  [[ "$NEED_H2" -eq 1 ]] && log "hysteria2: systemctl status hysteria2"
  log "env: /root/.env"
  if [[ "$MODE" == "private" ]]; then
    log "after first successful register, durable token is in /opt/fnode/api.token"
  fi
  if [[ "$FORCE_AWG_CONF" -eq 1 ]]; then
    log "junk regenerated — fully refresh the client subscription (do not keep old config)"
  fi
}

main
